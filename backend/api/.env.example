SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=events_db
DB_USER=events_user
DB_PASSWORD=Set-Your-Password
DB_HOST=db
DB_PORT=5432
TELEGRAM_BOT_TOKEN=ТВОЙ_ТОКЕН_ИЗ_BOTFATHER
TELEGRAM_WEBAPP_URL=http://localhost:5173

# Аутентификация: JWT живёт в httpOnly-cookie.
# JWT_COOKIE_SECURE=True в проде (HTTPS-only cookie); по умолчанию = not DEBUG.
JWT_COOKIE_SECURE=False

# Feature Toggles (Переключатели функций)
ENABLE_MULTIPLE_PHOTOGRAPHERS=True
ENABLE_STRICT_DEADLINES=True
ENABLE_EQUIPMENT_BOOKING=True
ENABLE_EVENT_CHAT=True
ENABLE_SKILL_LEVELS=True
ENABLE_TELEGRAM_BOT=True
ENABLE_CSV_REPORTS=True
