import requests
import json
res = requests.post('http://localhost:8000/api/token/', json={'username': 'admin', 'password': 'password123'})
token = res.json()['access']
res = requests.get('http://localhost:8000/api/events/', headers={'Authorization': f'Bearer {token}'})
events = res.json()
for e in events:
    print(e['title'], e['status'])
