import { useEffect, useState, useContext, useCallback, useRef } from 'react';
import {
  Box, Container, Typography, Card, Button, Avatar, IconButton, Chip, Paper, Stack,
  Table, TableBody, TableCell, TableContainer, TableHead, TableRow, TextField, MenuItem, Select,
  FormControl, InputLabel, CircularProgress, Tabs, Tab, Dialog, DialogTitle, DialogContent, DialogActions,
  Tooltip, TablePagination
} from '@mui/material';
import { useNavigate } from 'react-router-dom';
import {
  Inventory as InventoryIcon, Add as AddIcon, CheckCircle as CheckCircleIcon,
  Cancel as CancelIcon, AssignmentReturned as AssignmentReturnedIcon
} from '@mui/icons-material';
import toast, { Toaster } from 'react-hot-toast';
import { format, parseISO } from 'date-fns';
import { isAxiosError } from 'axios';
import api, { type AppUser, type Equipment, type Loan } from '../../services/api';
import { ThemeSettingsContext as ColorModeContext } from '../../theme/themeSettings';
import { useUpdatesBroker } from '../../services/useUpdatesBroker';

const CATEGORIES: Record<string, string> = {
  CAMERA: 'Камера',
  LENS: 'Объектив',
  LIGHT: 'Свет',
  AUDIO: 'Звук',
  OTHER: 'Другое'
};

const STATUSES: Record<string, { label: string; color: 'success' | 'warning' | 'error' }> = {
  AVAILABLE: { label: 'Доступно', color: 'success' },
  MAINTENANCE: { label: 'Ремонт', color: 'warning' },
  RETIRED: { label: 'Списано', color: 'error' }
};

const LOAN_STATUSES: Record<string, { label: string; color: 'warning' | 'success' | 'info' | 'default' | 'error' }> = {
  REQUESTED: { label: 'Запрошено', color: 'warning' },
  ISSUED: { label: 'Выдано', color: 'success' },
  RETURN_REQUESTED: { label: 'Возврат (запрос)', color: 'info' },
  RETURNED: { label: 'Возвращено', color: 'default' },
  REJECTED: { label: 'Отклонено', color: 'error' }
};

interface AdminLoan extends Loan {
  user?: { username?: string; first_name?: string; last_name?: string };
  issued_at?: string | null;
  returned_at?: string | null;
}

interface Paginated<T> {
  results?: T[];
  count?: number;
}

const Warehouse = () => {
  const { mode } = useContext(ColorModeContext);
  const navigate = useNavigate();

  const [loading, setLoading] = useState(true);
  const [equipment, setEquipment] = useState<Equipment[]>([]);
  const [loans, setLoans] = useState<AdminLoan[]>([]);
  const [user, setUser] = useState<AppUser | null>(null);
  
  const [activeTab, setActiveTab] = useState(0); // 0: Оборудование, 1: Запросы и Выдача

  const [eqModal, setEqModal] = useState({ open: false, id: null as number | null });
  const [eqForm, setEqForm] = useState({
    name: '',
    total_quantity: 1,
    description: '',
    serial_number: '',
    status: 'AVAILABLE',
    category: 'OTHER'
  });

  const [eqPage, setEqPage] = useState(0);
  const [eqRowsPerPage, setEqRowsPerPage] = useState(10);
  const [eqTotal, setEqTotal] = useState(0);

  const [loanPage, setLoanPage] = useState(0);
  const [loanRowsPerPage, setLoanRowsPerPage] = useState(10);
  const [loanTotal, setLoanTotal] = useState(0);

  // Refs mirror pagination state so loadData stays referentially stable
  // (the effect that calls it must run only on mount, as before).
  const eqPageRef = useRef(0);
  const eqRowsPerPageRef = useRef(10);
  const loanPageRef = useRef(0);
  const loanRowsPerPageRef = useRef(10);

  const fetchEquipment = useCallback(async (p: number, rpp: number) => {
    try {
      const res = await api.get<Paginated<Equipment> | Equipment[]>('equipment/', { params: { page: p + 1, page_size: rpp } });
      if ('results' in res.data && res.data.results !== undefined) {
        setEquipment(res.data.results);
        setEqTotal(res.data.count ?? 0);
      } else {
        setEquipment(res.data as Equipment[]);
        setEqTotal((res.data as Equipment[]).length);
      }
    } catch (err) {
      console.error(err);
      toast.error("Ошибка загрузки оборудования");
    }
  }, []);

  const fetchLoans = useCallback(async (p: number, rpp: number) => {
    try {
      const res = await api.get<Paginated<AdminLoan> | AdminLoan[]>('loans/', { params: { page: p + 1, page_size: rpp } });
      if ('results' in res.data && res.data.results !== undefined) {
        setLoans(res.data.results);
        setLoanTotal(res.data.count ?? 0);
      } else {
        setLoans(res.data as AdminLoan[]);
        setLoanTotal((res.data as AdminLoan[]).length);
      }
    } catch (err) {
      console.error(err);
      toast.error("Ошибка загрузки выданной техники");
    }
  }, []);

  const loadData = useCallback(() => {
    return api.get<AppUser>('users/me/')
      .then((uRes) => {
        if (uRes.data.role !== 'MAIN_ADMIN' && !uRes.data.can_manage_warehouse) {
          toast.error("Нет прав для управления складом");
          navigate('/app');
          return undefined;
        }
        setUser(uRes.data);
        return Promise.all([
          fetchEquipment(eqPageRef.current, eqRowsPerPageRef.current),
          fetchLoans(loanPageRef.current, loanRowsPerPageRef.current)
        ]);
      })
      .catch((error: unknown) => {
        toast.error("Ошибка загрузки данных склада");
        if (isAxiosError(error) && (error.response?.status === 401 || error.response?.status === 403)) {
          navigate('/');
        }
      })
      .finally(() => {
        setLoading(false);
      });
  }, [fetchEquipment, fetchLoans, navigate]);

  useEffect(() => {
    void loadData();
  }, [loadData]);

  useUpdatesBroker(['equipment', 'loan'], () => {
    fetchEquipment(eqPage, eqRowsPerPage);
    fetchLoans(loanPage, loanRowsPerPage);
  });

  const handleOpenEqModal = (item?: Equipment) => {
    if (item) {
      setEqForm({
        name: item.name,
        total_quantity: item.total_quantity,
        description: item.description || '',
        serial_number: item.serial_number || '',
        status: item.status,
        category: item.category
      });
      setEqModal({ open: true, id: item.id });
    } else {
      setEqForm({
        name: '',
        total_quantity: 1,
        description: '',
        serial_number: '',
        status: 'AVAILABLE',
        category: 'OTHER'
      });
      setEqModal({ open: true, id: null });
    }
  };

  const handleSaveEquipment = async () => {
    if (!eqForm.name.trim()) {
      toast.error("Название не может быть пустым");
      return;
    }

    try {
      if (eqModal.id) {
        await api.patch(`equipment/${eqModal.id}/`, eqForm);
        toast.success("Оборудование обновлено");
      } else {
        await api.post('equipment/', eqForm);
        toast.success("Оборудование добавлено");
      }
      setEqModal({ open: false, id: null });
      loadData();
    } catch {
      toast.error("Ошибка при сохранении");
    }
  };

  const handleDeleteEquipment = async (id: number) => {
    if (!window.confirm("Вы уверены, что хотите удалить это оборудование?")) return;
    try {
      await api.delete(`equipment/${id}/`);
      toast.success("Оборудование удалено");
      loadData();
    } catch {
      toast.error("Не удалось удалить оборудование. Возможно, оно задействовано в выданных заказах.");
    }
  };

  const handleLoanAction = async (loanId: number, action: 'approve_issue' | 'reject_request' | 'approve_return') => {
    try {
      await api.post(`loans/${loanId}/${action}/`);
      toast.success("Статус обновлен успешно");
      loadData();
    } catch (err) {
      let errMsg = "Ошибка обновления статуса";
      if (isAxiosError(err)) {
        const data = err.response?.data as { error?: string } | undefined;
        errMsg = data?.error || "Ошибка обновления статуса";
      }
      toast.error(errMsg);
    }
  };

  const formatDateString = (dateStr?: string | null) => {
    if (!dateStr) return '—';
    try {
      return format(parseISO(dateStr), 'dd.MM.yyyy HH:mm');
    } catch {
      return dateStr;
    }
  };

  if (loading && !user) {
    return (
      <Box sx={{ display: 'flex', height: '100vh', alignItems: 'center', justifyContent: 'center' }}>
        <CircularProgress />
      </Box>
    );
  }

  return (
    <Box sx={{ minHeight: '100vh', bgcolor: 'background.default', pb: 5 }}>
      <Toaster />

      <Typography variant="h4" sx={{ fontWeight: 900, mb: 4, mt: 2 }}>Склад оборудования</Typography>

      <Container maxWidth="lg" sx={{ mt: 4 }}>
        {/* Header section */}
        <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 4 }}>
          <Box>
            <Typography variant="h4" sx={{ fontWeight: 900 }}>Управление складом</Typography>
            <Typography variant="subtitle2" color="text.secondary">
              Учет инвентаря, мониторинг остатков и обработка заявок на выдачу техники
            </Typography>
          </Box>
          {activeTab === 0 && (
            <Button variant="contained" startIcon={<AddIcon />} onClick={() => handleOpenEqModal()}>
              Добавить технику
            </Button>
          )}
        </Box>

        {/* Tab selection */}
        <Tabs value={activeTab} onChange={(_, val) => setActiveTab(val)} sx={{ mb: 4 }}>
          <Tab label="Каталог техники" sx={{ fontWeight: 'bold' }} />
          <Tab label="Запросы и Выдачи" sx={{ fontWeight: 'bold' }} />
        </Tabs>

        {/* Catalog Tab */}
        {activeTab === 0 && (
          <Card sx={{ p: 3, boxShadow: '0 4px 20px 0 rgba(0,0,0,0.05)' }}>
            <TableContainer component={Paper} variant="outlined" sx={{ borderRadius: 2 }}>
              <Table>
                <TableHead sx={{ bgcolor: mode === 'dark' ? 'rgba(255,255,255,0.02)' : 'rgba(0,0,0,0.02)' }}>
                  <TableRow>
                    <TableCell sx={{ fontWeight: 'bold' }}>Название</TableCell>
                    <TableCell sx={{ fontWeight: 'bold' }}>Категория</TableCell>
                    <TableCell sx={{ fontWeight: 'bold' }}>Серийный №</TableCell>
                    <TableCell sx={{ fontWeight: 'bold' }} align="center">Всего</TableCell>
                    <TableCell sx={{ fontWeight: 'bold' }} align="center">В наличии</TableCell>
                    <TableCell sx={{ fontWeight: 'bold' }}>Статус</TableCell>
                    <TableCell sx={{ fontWeight: 'bold' }} align="right">Действия</TableCell>
                  </TableRow>
                </TableHead>
                <TableBody>
                  {equipment.length > 0 ? (
                    equipment.map((item) => (
                      <TableRow key={item.id} hover>
                        <TableCell>
                          <Stack direction="row" spacing={1.5} sx={{ alignItems: 'center' }}>
                            <Avatar sx={{ bgcolor: 'action.selected', color: 'primary.main', width: 36, height: 36 }}>
                              <InventoryIcon fontSize="small" />
                            </Avatar>
                            <Box>
                              <Typography variant="body2" sx={{ fontWeight: 600 }}>{item.name}</Typography>
                              {item.description && (
                                <Typography variant="caption" color="text.secondary" noWrap sx={{ display: 'block', maxWidth: 250 }}>
                                  {item.description}
                                </Typography>
                              )}
                            </Box>
                          </Stack>
                        </TableCell>
                        <TableCell>
                          <Chip label={CATEGORIES[item.category] || item.category} size="small" variant="outlined" />
                        </TableCell>
                        <TableCell sx={{ fontFamily: 'monospace' }}>{item.serial_number || '—'}</TableCell>
                        <TableCell align="center" sx={{ fontWeight: 500 }}>{item.total_quantity}</TableCell>
                        <TableCell align="center">
                          <Chip
                            label={`${item.available_quantity ?? 0} шт.`}
                            color={(item.available_quantity ?? 0) > 0 ? 'success' : 'error'}
                            size="small"
                            variant="filled"
                            sx={{ fontWeight: 'bold' }}
                          />
                        </TableCell>
                        <TableCell>
                          <Chip
                            label={STATUSES[item.status]?.label || item.status}
                            color={STATUSES[item.status]?.color || 'default'}
                            size="small"
                          />
                        </TableCell>
                        <TableCell align="right">
                          <Button size="small" onClick={() => handleOpenEqModal(item)}>Изм.</Button>
                          <Button size="small" color="error" onClick={() => handleDeleteEquipment(item.id)}>Удал.</Button>
                        </TableCell>
                      </TableRow>
                    ))
                  ) : (
                    <TableRow>
                      <TableCell colSpan={7} align="center">
                        <Typography variant="body2" color="text.secondary" sx={{ py: 3 }}>
                          На складе нет зарегистрированного оборудования
                        </Typography>
                      </TableCell>
                    </TableRow>
                  )}
                </TableBody>
              </Table>
            </TableContainer>
            <TablePagination
              rowsPerPageOptions={[5, 10, 25]}
              component="div"
              count={eqTotal}
              rowsPerPage={eqRowsPerPage}
              page={eqPage}
              onPageChange={(_, newPage) => {
                setEqPage(newPage);
                eqPageRef.current = newPage;
                fetchEquipment(newPage, eqRowsPerPage);
              }}
              onRowsPerPageChange={(event) => {
                const rpp = parseInt(event.target.value, 10);
                setEqRowsPerPage(rpp);
                eqRowsPerPageRef.current = rpp;
                setEqPage(0);
                eqPageRef.current = 0;
                fetchEquipment(0, rpp);
              }}
              labelRowsPerPage="Строк на странице:"
            />
          </Card>
        )}

        {/* Requests & Loans Tab */}
        {activeTab === 1 && (
          <Card sx={{ p: 3, boxShadow: '0 4px 20px 0 rgba(0,0,0,0.05)' }}>
            <TableContainer component={Paper} variant="outlined" sx={{ borderRadius: 2 }}>
              <Table>
                <TableHead sx={{ bgcolor: mode === 'dark' ? 'rgba(255,255,255,0.02)' : 'rgba(0,0,0,0.02)' }}>
                  <TableRow>
                    <TableCell sx={{ fontWeight: 'bold' }}>Исполнитель</TableCell>
                    <TableCell sx={{ fontWeight: 'bold' }}>Техника</TableCell>
                    <TableCell sx={{ fontWeight: 'bold' }} align="center">Кол-во</TableCell>
                    <TableCell sx={{ fontWeight: 'bold' }}>Событие</TableCell>
                    <TableCell sx={{ fontWeight: 'bold' }}>Статус</TableCell>
                    <TableCell sx={{ fontWeight: 'bold' }}>Даты</TableCell>
                    <TableCell sx={{ fontWeight: 'bold' }} align="right">Решение</TableCell>
                  </TableRow>
                </TableHead>
                <TableBody>
                  {loans.length > 0 ? (
                    loans.map((loan) => (
                      <TableRow key={loan.id} hover>
                        <TableCell>
                          <Typography variant="body2" sx={{ fontWeight: 600 }}>{loan.user?.username}</Typography>
                          <Typography variant="caption" color="text.secondary">
                            {`${loan.user?.first_name || ''} ${loan.user?.last_name || ''}`.trim() || 'ФИО не указано'}
                          </Typography>
                        </TableCell>
                        <TableCell>
                          <Typography variant="body2" sx={{ fontWeight: 600 }}>{loan.equipment?.name}</Typography>
                          {loan.equipment?.serial_number && (
                            <Typography variant="caption" color="text.secondary" sx={{ fontFamily: 'monospace' }}>
                              S/N: {loan.equipment.serial_number}
                            </Typography>
                          )}
                        </TableCell>
                        <TableCell align="center" sx={{ fontWeight: 600 }}>{loan.quantity}</TableCell>
                        <TableCell>
                          {loan.event_title ? (
                            <Typography variant="body2" sx={{ maxWidth: 150 }} noWrap title={loan.event_title}>
                              {loan.event_title}
                            </Typography>
                          ) : (
                            <Typography variant="caption" color="text.disabled">Личный запрос</Typography>
                          )}
                        </TableCell>
                        <TableCell>
                          <Chip
                            label={LOAN_STATUSES[loan.status]?.label || loan.status}
                            color={LOAN_STATUSES[loan.status]?.color || 'default'}
                            size="small"
                          />
                        </TableCell>
                        <TableCell>
                          <Box sx={{ display: 'flex', flexDirection: 'column', gap: 0.5 }}>
                            {loan.loan_start && loan.loan_end && (
                              <Typography variant="caption" color="primary.main" sx={{ fontWeight: 'bold' }}>
                                Период: {formatDateString(loan.loan_start)} - {formatDateString(loan.loan_end)}
                              </Typography>
                            )}
                            <Typography variant="caption" color="text.secondary">
                              Запрос: {formatDateString(loan.requested_at)}
                            </Typography>
                            {loan.issued_at && (
                              <Typography variant="caption" color="success.main">
                                Выдано: {formatDateString(loan.issued_at)}
                              </Typography>
                            )}
                            {loan.returned_at && (
                              <Typography variant="caption" color="text.disabled">
                                Возврат: {formatDateString(loan.returned_at)}
                              </Typography>
                            )}
                          </Box>
                        </TableCell>

                        <TableCell align="right">
                          <Stack direction="row" spacing={1} sx={{ justifyContent: 'flex-end' }}>
                            {loan.status === 'REQUESTED' && (
                              <>
                                <Tooltip title="Выдать технику">
                                  <IconButton
                                    size="small"
                                    color="success"
                                    onClick={() => handleLoanAction(loan.id, 'approve_issue')}
                                  >
                                    <CheckCircleIcon />
                                  </IconButton>
                                </Tooltip>
                                <Tooltip title="Отклонить запрос">
                                  <IconButton
                                    size="small"
                                    color="error"
                                    onClick={() => handleLoanAction(loan.id, 'reject_request')}
                                  >
                                    <CancelIcon />
                                  </IconButton>
                                </Tooltip>
                              </>
                            )}
                            {loan.status === 'RETURN_REQUESTED' && (
                              <Tooltip title="Подтвердить возврат">
                                <IconButton
                                  size="small"
                                  color="info"
                                  onClick={() => handleLoanAction(loan.id, 'approve_return')}
                                >
                                  <AssignmentReturnedIcon />
                                </IconButton>
                              </Tooltip>
                            )}
                            {loan.status === 'ISSUED' && (
                              <Tooltip title="Принудительно вернуть">
                                <IconButton
                                  size="small"
                                  color="secondary"
                                  onClick={() => handleLoanAction(loan.id, 'approve_return')}
                                >
                                  <AssignmentReturnedIcon />
                                </IconButton>
                              </Tooltip>
                            )}
                          </Stack>
                        </TableCell>
                      </TableRow>
                    ))
                  ) : (
                    <TableRow>
                      <TableCell colSpan={7} align="center">
                        <Typography variant="body2" color="text.secondary" sx={{ py: 3 }}>
                          История запросов пуста
                        </Typography>
                      </TableCell>
                    </TableRow>
                  )}
                </TableBody>
              </Table>
            </TableContainer>
            <TablePagination
              rowsPerPageOptions={[5, 10, 25]}
              component="div"
              count={loanTotal}
              rowsPerPage={loanRowsPerPage}
              page={loanPage}
              onPageChange={(_, newPage) => {
                setLoanPage(newPage);
                loanPageRef.current = newPage;
                fetchLoans(newPage, loanRowsPerPage);
              }}
              onRowsPerPageChange={(event) => {
                const rpp = parseInt(event.target.value, 10);
                setLoanRowsPerPage(rpp);
                loanRowsPerPageRef.current = rpp;
                setLoanPage(0);
                loanPageRef.current = 0;
                fetchLoans(0, rpp);
              }}
              labelRowsPerPage="Строк на странице:"
            />
          </Card>
        )}
      </Container>

      {/* Equipment CRUD Dialog */}
      <Dialog open={eqModal.open} onClose={() => setEqModal({ open: false, id: null })} fullWidth maxWidth="sm">
        <DialogTitle sx={{ fontWeight: 900 }}>
          {eqModal.id ? 'Редактировать оборудование' : 'Добавить оборудование'}
        </DialogTitle>
        <DialogContent dividers>
          <TextField
            fullWidth
            label="Название"
            margin="dense"
            value={eqForm.name}
            onChange={(e) => setEqForm({ ...eqForm, name: e.target.value })}
            sx={{ mb: 2 }}
          />

          <Stack direction="row" spacing={2} sx={{ mb: 2 }}>
            <FormControl fullWidth>
              <InputLabel>Категория</InputLabel>
              <Select
                value={eqForm.category}
                label="Категория"
                onChange={(e) => setEqForm({ ...eqForm, category: e.target.value })}
              >
                {Object.entries(CATEGORIES).map(([key, label]) => (
                  <MenuItem key={key} value={key}>{label}</MenuItem>
                ))}
              </Select>
            </FormControl>

            <FormControl fullWidth>
              <InputLabel>Статус</InputLabel>
              <Select
                value={eqForm.status}
                label="Статус"
                onChange={(e) => setEqForm({ ...eqForm, status: e.target.value })}
              >
                {Object.entries(STATUSES).map(([key, data]) => (
                  <MenuItem key={key} value={key}>{data.label}</MenuItem>
                ))}
              </Select>
            </FormControl>
          </Stack>

          <Stack direction="row" spacing={2} sx={{ mb: 2 }}>
            <TextField
              fullWidth
              label="Серийный номер"
              value={eqForm.serial_number}
              onChange={(e) => setEqForm({ ...eqForm, serial_number: e.target.value })}
            />
            <TextField
              fullWidth
              type="number"
              label="Общее количество"
              value={eqForm.total_quantity}
              onChange={(e) => setEqForm({ ...eqForm, total_quantity: Math.max(1, parseInt(e.target.value) || 1) })}
            />
          </Stack>

          <TextField
            fullWidth
            multiline
            rows={3}
            label="Описание / Примечания"
            value={eqForm.description}
            onChange={(e) => setEqForm({ ...eqForm, description: e.target.value })}
          />
        </DialogContent>
        <DialogActions sx={{ p: 2 }}>
          <Button onClick={() => setEqModal({ open: false, id: null })}>Отмена</Button>
          <Button variant="contained" onClick={handleSaveEquipment}>Сохранить</Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
};

export default Warehouse;
