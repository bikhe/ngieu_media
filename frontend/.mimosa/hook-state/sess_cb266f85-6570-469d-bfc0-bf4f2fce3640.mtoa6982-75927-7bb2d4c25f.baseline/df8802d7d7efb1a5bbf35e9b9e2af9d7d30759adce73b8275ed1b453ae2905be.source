import { useState, useEffect, useRef } from 'react';
import {
  Drawer,
  Box,
  Typography,
  IconButton,
  TextField,
  List,
  ListItem,
  Paper,
  CircularProgress,
} from '@mui/material';
import { Send, X } from 'lucide-react';
import { apiService } from '../services/api';
import type { Comment } from '../services/api';
import { useUpdatesBroker } from '../services/useUpdatesBroker';


interface ChatDrawerProps {
  open: boolean;
  onClose: () => void;
  eventId: number;
  currentUser: {
    username?: string;
  };
}

export const ChatDrawer: React.FC<ChatDrawerProps> = ({
  open,
  onClose,
  eventId,
  currentUser,
}) => {
  const [comments, setComments] = useState<Comment[]>([]);
  const [loading, setLoading] = useState(true);
  const [text, setText] = useState('');
  const [sending, setSending] = useState(false);
  const listEndRef = useRef<HTMLDivElement | null>(null);

  const loadComments = async (showLoading = false) => {
    if (showLoading) setLoading(true);
    try {
      const data = await apiService.getComments(eventId);
      setComments(data);
    } catch (err) {
      console.error('Failed to load comments:', err);
    } finally {
      if (showLoading) setLoading(false);
    }
  };

  useEffect(() => {
    if (!open) return;
    loadComments(true);
  }, [open, eventId]);

  // Real-time updates broker integration for new chat messages
  useUpdatesBroker(['comment'], (log) => {
    if (open && log.extra_data?.event_id === eventId) {
      loadComments(false);
    }
  });

  useEffect(() => {
    listEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [comments]);

  const handleSend = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!text.trim() || sending) return;

    setSending(true);
    try {
      const success = await apiService.postComment(eventId, text.trim());
      if (success) {
        setText('');
        await loadComments(false);
      }
    } catch (err) {
      console.error('Failed to send comment:', err);
    } finally {
      setSending(false);
    }
  };

  return (
    <Drawer
      anchor="bottom"
      open={open}
      onClose={onClose}
      slotProps={{
        paper: {
          sx: {
            height: '70vh',
            borderTopLeftRadius: 16,
            borderTopRightRadius: 16,
            display: 'flex',
            flexDirection: 'column',
            bgcolor: 'background.default',
          },
        },
      }}
    >
      {/* Header */}
      <Box
        sx={{
          p: 2,
          borderBottom: 1,
          borderColor: 'divider',
          display: 'flex',
          justifyContent: 'space-between',
          alignItems: 'center',
          position: 'sticky',
          top: 0,
          bgcolor: 'background.default',
          zIndex: 1,
        }}
      >
        <Typography variant="h6" sx={{ fontWeight: 'bold' }}>
          Чат мероприятия
        </Typography>
        <IconButton onClick={onClose} edge="end">
          <X size={20} />
        </IconButton>
      </Box>

      {/* Messages list */}
      <Box sx={{ flexGrow: 1, overflowY: 'auto', p: 2 }} className="no-scrollbar">
        {loading ? (
          <Box sx={{ display: 'flex', justifyContent: 'center', alignItems: 'center', height: '100%' }}>
            <CircularProgress size={30} />
          </Box>
        ) : comments.length === 0 ? (
          <Box sx={{ display: 'flex', justifyContent: 'center', alignItems: 'center', height: '100%' }}>
            <Typography variant="body2" color="text.secondary">
              Нет сообщений. Напишите что-нибудь первым!
            </Typography>
          </Box>
        ) : (
          <List disablePadding>
            {comments.map((comment) => {
              const isMe = comment.author?.username === currentUser.username;
              const authorName = comment.author?.first_name
                ? `${comment.author.first_name} ${comment.author.last_name || ''}`.trim()
                : comment.author?.username || 'User';

              return (
                <ListItem
                  key={comment.id}
                  disablePadding
                  sx={{
                    justifyContent: isMe ? 'flex-end' : 'flex-start',
                    mb: 1.5,
                  }}
                >
                  <Paper
                    elevation={0}
                    sx={{
                      p: 1.5,
                      px: 2,
                      maxWidth: '80%',
                      borderRadius: 3,
                      borderTopRightRadius: isMe ? 2 : 12,
                      borderTopLeftRadius: isMe ? 12 : 2,
                      bgcolor: isMe ? 'primary.main' : 'action.selected',
                      color: isMe ? 'primary.contrastText' : 'text.primary',
                    }}
                  >
                    {!isMe && (
                      <Typography
                        variant="caption"
                        sx={{
                          fontWeight: 'bold',
                          display: 'block',
                          color: 'primary.light',
                          mb: 0.5,
                        }}
                      >
                        {authorName}
                      </Typography>
                    )}
                    <Typography variant="body2" sx={{ whiteSpace: 'pre-wrap', wordBreak: 'break-word' }}>
                      {comment.text}
                    </Typography>
                    {comment.created_at && (
                      <Typography
                        variant="caption"
                        sx={{
                          display: 'block',
                          textAlign: 'right',
                          mt: 0.5,
                          opacity: 0.7,
                          fontSize: '0.65rem',
                        }}
                      >
                        {new Date(comment.created_at).toLocaleString('ru-RU', {
                          hour: '2-digit',
                          minute: '2-digit',
                          day: 'numeric',
                          month: 'short',
                        })}
                      </Typography>
                    )}
                  </Paper>
                </ListItem>
              );
            })}
            <div ref={listEndRef} />
          </List>
        )}
      </Box>

      {/* Input Form */}
      <Box
        component="form"
        onSubmit={handleSend}
        sx={{
          p: 2,
          borderTop: 1,
          borderColor: 'divider',
          display: 'flex',
          gap: 1,
          alignItems: 'center',
          bgcolor: 'background.default',
        }}
      >
        <TextField
          value={text}
          onChange={(e) => setText(e.target.value)}
          placeholder="Сообщение..."
          fullWidth
          size="medium"
          variant="outlined"
          autoComplete="off"
          sx={{
            '& .MuiOutlinedInput-root': {
              borderRadius: 6,
            },
          }}
        />
        <IconButton
          type="submit"
          color="primary"
          disabled={!text.trim() || sending}
          sx={{
            bgcolor: 'primary.main',
            color: 'primary.contrastText',
            p: 1.5,
            '&:hover': {
              bgcolor: 'primary.dark',
            },
            '&.Mui-disabled': {
              bgcolor: 'action.disabledBackground',
              color: 'action.disabled',
            },
          }}
        >
          <Send size={18} />
        </IconButton>
      </Box>
    </Drawer>
  );
};

export default ChatDrawer;
